<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.forddevinc.OpenShelf.shared</string>
    </array>
    <!-- CloudKit requires real code signing with a provisioning profile.
         These entitlements are set up correctly but will only function
         when the app is signed with a real Apple Developer identity. -->
    <key>com.apple.developer.weatherkit</key>
    <true/>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.forddevinc.OpenShelf</string>
    </array>
</dict>
</plist>
